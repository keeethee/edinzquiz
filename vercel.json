{
  "version": 2,
  "outputDirectory": "frontend/dist/frontend",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://edinz-quiz-backend.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
